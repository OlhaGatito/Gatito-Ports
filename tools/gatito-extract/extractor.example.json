{
  "id": "example-port",
  "version": "1",
  "abi_order": ["arm64-v8a", "armeabi-v7a"],
  "extract": [
    {
      "source": {"patterns": ["lib/{abi}/libexample.so"]},
      "destination": "game/libexample.so"
    }
  ],
  "validate": [{"path": "game/libexample.so", "min_size": 1024}],
  "commit": {"root": "game"}
}
